{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-ssh-terminal-client",
  "version": "0.1.5",
  "identifier": "com.jasonlat.ai-ssh-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent SSH",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "backgroundColor": "#f2f7ff",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": {
      "bundle/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFOTFFNTIyQzlDOUVEClJXVHR5Y2tpNVpFZUFNajZSd21acnNsaDlkcDlSYndpZ3BNd2tOa256QzBlNTJKVTJOVVRmR0k1Cg==",
      "endpoints": [
        "https://github.com/jasonlat-dot/ai-ssh-terminal-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
