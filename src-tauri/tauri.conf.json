{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellPilot-Rust-Preview",
  "version": "0.4.0",
  "identifier": "com.jasonlat.shellpilot.rust-preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShellPilot · Rust 试用版",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "backgroundColor": "#f2f7ff",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "resources": {
      "bundle/rust-preview.txt": "rust-preview.txt",
      "bundle/backend-LICENSE.txt": "backend-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFOTFFNTIyQzlDOUVEClJXVHR5Y2tpNVpFZUFNajZSd21acnNsaDlkcDlSYndpZ3BNd2tOa256QzBlNTJKVTJOVVRmR0k1Cg==",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}