{
  "name": "ai-ssh-terminal-client",
  "displayName": "ShellPilot-Rust-Preview",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "prepare:icons": "node scripts/prepare-app-icons.mjs",
    "predev": "npm run prepare:icons",
    "dev": "vite",
    "prebuild": "npm run prepare:icons",
    "build": "tsc && vite build",
    "dev:rust-server": "cargo run --manifest-path ../ai-ssh-terminal-server-rust/Cargo.toml",
    "build:rust-server": "cargo build --release --manifest-path ../ai-ssh-terminal-server-rust/Cargo.toml",
    "prepare:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-backend-bundle.ps1",
    "prepare:bundle": "npm run prepare:backend && npm run build",
    "bundle:nsis": "node scripts/windows-bundle.mjs nsis",
    "bundle:msi": "node scripts/windows-bundle.mjs msi",
    "bundle:windows": "node scripts/windows-bundle.mjs nsis,msi",
    "updater:configure": "node scripts/updater-release.mjs configure",
    "release:windows": "node scripts/updater-release.mjs build",
    "release:manifest": "node scripts/updater-release.mjs manifest",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:files": "tsx tests/files.test.ts",
    "test:chat-attachments": "tsx tests/chat-attachments.test.ts",
    "test:markdown": "tsx tests/markdown.test.ts",
    "test:sftp": "tsx tests/sftp.test.ts",
    "test:files:rust": "cargo build --manifest-path ../ai-ssh-terminal-server-rust/Cargo.toml && tsx tests/files-rust-live.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "2.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.16.47",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
