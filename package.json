{
  "name": "ai-ssh-terminal-client",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-backend-bundle.ps1",
    "prepare:bundle": "npm run prepare:backend && npm run build",
    "bundle:nsis": "tauri build --bundles nsis",
    "bundle:msi": "tauri build --bundles msi",
    "bundle:windows": "tauri build --bundles nsis,msi",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:files": "node --experimental-strip-types tests/files.test.ts",
    "test:chat-attachments": "node --experimental-strip-types tests/chat-attachments.test.ts",
    "test:markdown": "node --experimental-strip-types tests/markdown.test.ts",
    "test:sftp": "node --experimental-strip-types tests/sftp.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remend": "^1.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
